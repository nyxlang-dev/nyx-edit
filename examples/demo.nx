// demo.nx — Minimal terminal text viewer using the same builtins as nyx-edit.
//
// This is NOT the editor itself (that's src/main.nx). This demo shows how
// Nyx's terminal builtins work: raw mode, reading keys, and rendering text.
//
// Usage:
//   make compile FILE=products/edit/examples/demo.nx
//   ./script_bin file.txt
//
// Press 'q' to quit, arrows to scroll.

fn main() -> int {
    let args = get_args()
    if args.length() < 2 {
        print("Usage: demo <file>")
        return 1
    }

    let filename: String = args[1]
    let content: String = read_file(filename)
    let lines: Array = content.split("\n")
    var offset: int = 0
    let rows: int = term_rows() - 1

    raw_mode_enter()
    defer { raw_mode_exit() }

    var running: bool = true
    while running {
        // Render visible lines
        var buf: String = "\x1b[H\x1b[2J"
        var i: int = 0
        while i < rows and (offset + i) < lines.length() {
            let line: String = lines[offset + i]
            buf = buf + line + "\r\n"
            i = i + 1
        }
        let status: String = "[" + filename + "] line " + int_to_string(offset + 1) + "/" + int_to_string(lines.length()) + " | q=quit"
        buf = buf + "\x1b[7m" + status + "\x1b[0m"
        print_no_newline(buf)

        // Read key
        let b: int = read_byte()
        if b == 113 {
            running = false
        }
        if b == 27 {
            let b2: int = read_byte()
            if b2 == 91 {
                let b3: int = read_byte()
                if b3 == 65 and offset > 0 { offset = offset - 1 }
                if b3 == 66 and offset < lines.length() - rows { offset = offset + 1 }
            }
        }
    }

    return 0
}
